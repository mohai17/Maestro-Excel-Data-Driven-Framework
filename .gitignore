# ==========================================
# Dependencies
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ==========================================
# Generated Test Data & Reports
# ==========================================
# Ignore generated JSON test data (re-generated on each run)
JsonData/*/*.json

# Ignore generated test reports and logs
reports/
*.xml
*.log

# ==========================================
# OS & IDE System Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Visual Studio Code / Editors
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# Temporary Files
# ==========================================
# Ignore Excel temporary/lock files created while editing
~$*.xlsx
~$*.xls
*.tmp